class Solution {
public:
    bool checkRecord(string s) {
        int a=0,l=0,p=0,i;
        for(i=0;i<s.size();i++){
            if(s[i]=='A') a++;
            if(i<(s.size()-2)&&s[i]=='L'&&s[i+1]=='L'&&s[i+2]=='L') return false;
            if(s[i]=='P') p++;
        }
        if(a>=2) return false;
        else if(l>=3) return false;
        else return true;
    }
};
