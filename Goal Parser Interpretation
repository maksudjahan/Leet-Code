class Solution {
public:
    string interpret(string command) {
        string r="";
        for(int i=0;i<command.size();i++){
           if((command[i]=='(')&&(command[i+1]==')')) {
            r.push_back('o');
           }
            else if(command[i]=='('||command[i]==')') continue;
           else r.push_back(command[i]);
        }
        return r;
    }
};
